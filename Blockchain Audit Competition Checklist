<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🛡 Blockchain Audit Competition Checklist</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
            color: #ffffff;
            min-height: 100vh;
            padding: 20px;
        }
        
        .mindmap-container {
            max-width: 1400px;
            margin: 0 auto;
            position: relative;
        }
        
        .title {
            text-align: center;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 40px;
            background: linear-gradient(45deg, #ff6b6b, #4ecdc4, #45b7d1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 30px rgba(255, 107, 107, 0.3);
        }
        
        .mindmap {
            position: relative;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            min-height: 800px;
        }
        
        .central-node {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: 3px solid #ffffff;
            border-radius: 50%;
            width: 180px;
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-weight: bold;
            font-size: 1.2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            z-index: 10;
        }
        
        .branch {
            position: relative;
            background: linear-gradient(135deg, #2c3e50, #3498db);
            border-radius: 15px;
            padding: 20px;
            margin: 10px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            max-width: 320px;
        }
        
        .branch:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
            border-color: rgba(255, 255, 255, 0.3);
        }
        
        .branch-title {
            font-size: 1.3rem;
            font-weight: bold;
            margin-bottom: 15px;
            color: #4ecdc4;
            border-bottom: 2px solid #4ecdc4;
            padding-bottom: 8px;
        }
        
        .branch-content {
            line-height: 1.6;
        }
        
        .sub-item {
            margin: 8px 0;
            padding-left: 15px;
            position: relative;
            font-size: 0.95rem;
        }
        
        .sub-item::before {
            content: "▶";
            position: absolute;
            left: 0;
            color: #ff6b6b;
        }
        
        .nested-item {
            margin: 5px 0 5px 20px;
            font-size: 0.9rem;
            color: #e0e0e0;
        }
        
        .nested-item::before {
            content: "•";
            color: #ffd93d;
            margin-right: 8px;
        }
        
        .code {
            background: rgba(0, 0, 0, 0.3);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 0.85rem;
            color: #6c5ce7;
        }
        
        .highlight {
            background: linear-gradient(45deg, rgba(255, 107, 107, 0.2), rgba(78, 205, 196, 0.2));
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: bold;
        }
        
        .branch-1 { transform: translate(-350px, -200px); }
        .branch-2 { transform: translate(150px, -250px); }
        .branch-3 { transform: translate(-400px, 50px); }
        .branch-4 { transform: translate(200px, 80px); }
        .branch-5 { transform: translate(-250px, 300px); }
        .branch-6 { transform: translate(350px, 280px); }
        
        .connection-line {
            position: absolute;
            height: 2px;
            background: linear-gradient(90deg, #4ecdc4, #45b7d1);
            opacity: 0.6;
            z-index: 1;
            border-radius: 1px;
        }
        
        .line-1 { width: 250px; top: 40%; left: 30%; transform: rotate(-25deg); }
        .line-2 { width: 200px; top: 35%; right: 35%; transform: rotate(30deg); }
        .line-3 { width: 280px; top: 55%; left: 25%; transform: rotate(15deg); }
        .line-4 { width: 220px; top: 60%; right: 30%; transform: rotate(-20deg); }
        .line-5 { width: 200px; bottom: 35%; left: 40%; transform: rotate(40deg); }
        .line-6 { width: 180px; bottom: 40%; right: 25%; transform: rotate(-35deg); }
        
        @media (max-width: 1200px) {
            .branch {
                position: static !important;
                transform: none !important;
                margin: 20px auto;
                max-width: 500px;
            }
            
            .central-node {
                position: static;
                transform: none;
                margin: 20px auto;
            }
            
            .connection-line {
                display: none;
            }
            
            .mindmap {
                flex-direction: column;
                align-items: center;
            }
        }
        
        .print-button {
            position: fixed;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
            z-index: 1000;
        }
        
        .print-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        }
        
        @media print {
            body {
                background: white;
                color: black;
            }
            .print-button { display: none; }
            .branch { 
                background: #f8f9fa; 
                border: 2px solid #333;
                break-inside: avoid;
            }
            .central-node { 
                background: #333; 
                color: white;
            }
            .branch-title { color: #333; }
        }
    </style>
</head>
<body>
    <button class="print-button" onclick="window.print()">🖨️ Save as PDF</button>
    
    <div class="mindmap-container">
        <h1 class="title">🛡️ Blockchain Audit Competition Checklist</h1>
        
        <div class="mindmap">
            <!-- Connection Lines -->
            <div class="connection-line line-1"></div>
            <div class="connection-line line-2"></div>
            <div class="connection-line line-3"></div>
            <div class="connection-line line-4"></div>
            <div class="connection-line line-5"></div>
            <div class="connection-line line-6"></div>
            
            <!-- Central Node -->
            <div class="central-node">
                <div>
                    🛡️<br>
                    <strong>BLOCKCHAIN<br>AUDIT<br>CHECKLIST</strong>
                </div>
            </div>
            
            <!-- Branch 1: Setup & Environment -->
            <div class="branch branch-1">
                <div class="branch-title">1. 🔧 Setup & Environment</div>
                <div class="branch-content">
                    <div class="sub-item">Clone target repo + download audit reports</div>
                    <div class="sub-item">Install dependencies</div>
                    <div class="nested-item"><span class="code">forge</span>, <span class="code">slither</span>, <span class="code">hardhat</span></div>
                    <div class="sub-item">Start local fork</div>
                    <div class="nested-item"><span class="code">anvil --fork $RPC_URL</span></div>
                    <div class="sub-item">Run test suite</div>
                    <div class="nested-item"><span class="code">forge test</span> / <span class="code">npx hardhat test</span></div>
                    <div class="sub-item">Confirm contracts deployed + scope verified</div>
                </div>
            </div>
            
            <!-- Branch 2: Automated Recon -->
            <div class="branch branch-2">
                <div class="branch-title">2. 🤖 Automated Recon</div>
                <div class="branch-content">
                    <div class="sub-item">Run <span class="highlight">Slither</span> for static analysis</div>
                    <div class="sub-item">Run <span class="highlight">Mythril/MythX</span> (if available)</div>
                    <div class="sub-item">Consider <span class="highlight">Echidna/fuzzing</span> for invariant checks</div>
                    <div class="sub-item">Collect flagged issues, verify manually</div>
                </div>
            </div>
            
            <!-- Branch 3: Manual Review -->
            <div class="branch branch-3">
                <div class="branch-title">3. 🔍 Manual Review – High ROI</div>
                <div class="branch-content">
                    <div class="sub-item"><span class="highlight">Access Control</span></div>
                    <div class="nested-item">Missing <span class="code">onlyOwner</span> or role checks</div>
                    <div class="nested-item">Privileged functions callable by anyone</div>
                    
                    <div class="sub-item"><span class="highlight">Accounting & Invariants</span></div>
                    <div class="nested-item">Balance mismatches (<span class="code">totalSupply</span>, <span class="code">vault accounting</span>)</div>
                    <div class="nested-item">Double spend or unlocked collateral</div>
                    
                    <div class="sub-item"><span class="highlight">Reentrancy Risks</span></div>
                    <div class="nested-item">External calls before state updates</div>
                    <div class="nested-item">ERC777 / callbacks</div>
                    
                    <div class="sub-item"><span class="highlight">Unchecked Return Values</span></div>
                    <div class="nested-item"><span class="code">ERC20.transfer</span>, <span class="code">call.value</span></div>
                </div>
            </div>
            
            <!-- Branch 4: More Manual Checks -->
            <div class="branch branch-4">
                <div class="branch-title">3. 🔍 Manual Review (cont.)</div>
                <div class="branch-content">
                    <div class="sub-item"><span class="highlight">Oracle / Price Manipulation</span></div>
                    <div class="nested-item">Weak reliance on FTSO data</div>
                    <div class="nested-item">No sanity checks on prices</div>
                    
                    <div class="sub-item"><span class="highlight">Loop/Array Growth</span></div>
                    <div class="nested-item">Unbounded loops (<span class="code">escrows[]</span>)</div>
                    <div class="nested-item">Gas exhaustion / DoS</div>
                    
                    <div class="sub-item"><span class="highlight">Time & Expiry</span></div>
                    <div class="nested-item">Rounding, timestamp assumptions</div>
                    <div class="nested-item">Expiry edge cases</div>
                    
                    <div class="sub-item"><span class="highlight">Delegatecall/Proxies</span></div>
                    <div class="nested-item">Insecure upgradeability or context switching</div>
                </div>
            </div>
            
            <!-- Branch 5: Exploit Development & Report Writing -->
            <div class="branch branch-5">
                <div class="branch-title">4. ⚡ Exploit Development</div>
                <div class="branch-content">
                    <div class="sub-item">Write <span class="highlight">minimal PoC</span> (Foundry/Hardhat)</div>
                    <div class="sub-item">Show <span class="highlight">pre-attack</span> balances/state</div>
                    <div class="sub-item">Execute attack sequence</div>
                    <div class="sub-item">Show <span class="highlight">post-attack</span> state (broken invariant / profit)</div>
                    <div class="sub-item">Keep reproducible, single command/test</div>
                </div>
                
                <div class="branch-title" style="margin-top: 20px;">5. 📝 Report Writing</div>
                <div class="branch-content">
                    <div class="sub-item"><span class="highlight">Title:</span> short bug name</div>
                    <div class="sub-item"><span class="highlight">Scope:</span> affected contract + function</div>
                    <div class="sub-item"><span class="highlight">Severity:</span> Critical/High/Medium/Low</div>
                    <div class="sub-item"><span class="highlight">Impact:</span> what attacker achieves</div>
                    <div class="sub-item"><span class="highlight">Steps to Reproduce:</span> clear + numbered</div>
                    <div class="sub-item"><span class="highlight">PoC Code/Scripts:</span> full & runnable</div>
                </div>
            </div>
            
            <!-- Branch 6: Rules & Prohibited -->
            <div class="branch branch-6">
                <div class="branch-title">6. ⚠️ Rules & Prohibited</div>
                <div class="branch-content">
                    <div class="sub-item">❌ No mainnet/testnet testing (local fork only)</div>
                    <div class="sub-item">❌ No phishing/social engineering</div>
                    <div class="sub-item">❌ No DoS on live infra</div>
                    <div class="sub-item">❌ No oracle/spam abuse on real network</div>
                    <div class="sub-item">✅ Respect Immunefi embargo & disclosure rules</div>
                    
                    <div style="margin-top: 15px; padding: 10px; background: rgba(255, 107, 107, 0.1); border-radius: 8px; border-left: 4px solid #ff6b6b;">
                        <strong>Remember:</strong> Focus on <span class="highlight">local testing</span> and <span class="highlight">responsible disclosure</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Add some interactivity
        document.querySelectorAll('.branch').forEach(branch => {
            branch.addEventListener('click', function() {
                this.style.transform += ' scale(1.05)';
                setTimeout(() => {
                    this.style.transform = this.style.transform.replace(' scale(1.05)', '');
                }, 200);
            });
        });
        
        // Add print optimization
        window.addEventListener('beforeprint', function() {
            document.querySelectorAll('.branch').forEach(branch => {
                branch.style.position = 'static';
                branch.style.transform = 'none';
                branch.style.margin = '20px auto';
                branch.style.maxWidth = '100%';
            });
            
            document.querySelector('.central-node').style.position = 'static';
            document.querySelector('.central-node').style.transform = 'none';
            document.querySelector('.central-node').style.margin = '20px auto';
        });
    </script>
</body>
</html>
